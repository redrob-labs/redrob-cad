     }
+    // A profile from before the rename names the theme by its earlier name, whose parameter
+    // file no longer exists. Point it at the same theme under the product's name.
+    if (hGrp->GetASCII("Theme") == "OpenCAD") {  // legacy-name: profiles from before the rename
+        hGrp->SetASCII("Theme", "Redrob CAD");
+    }
+    if (style.empty()) {
+        // New profiles start with the Redrob CAD theme. Persist both values before observers
+        // run; otherwise the delayed theme refresh would reapply an empty style.
+        style = "FreeCAD.qss";
+        hGrp->SetASCII("StyleSheet", style.c_str());
+        if (hGrp->GetASCII("Theme").empty()) {
+            hGrp->SetASCII("Theme", "Redrob CAD");
+        }
+    }
 
