@@ -539,6 +539,15 @@ void StartupPostProcess::setStyleSheet()
             style = it->second;
         }
     }
+    if (style.empty()) {
+        // New OpenCAD profiles start with the lightweight native Qt theme. Persist both values
+        // before observers run; otherwise the delayed theme refresh would reapply an empty style.
+        style = "FreeCAD.qss";
+        hGrp->SetASCII("StyleSheet", style.c_str());
+        if (hGrp->GetASCII("Theme").empty()) {
+            hGrp->SetASCII("Theme", "OpenCAD");
+        }
+    }
 
     // In 1.1 we migrated to a common parametrized stylesheet.
     // if we detect an old style, we need to reapply the theme pack.
