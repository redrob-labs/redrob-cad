-bool Document::saveCameraSettings(const char* settings) const
-{
-    if (!settings) {
-        return false;
-    }
-
-    // skip starting comment lines
-    bool skipping = false;
-    char c = *settings;
-    for (; c; c = *(++settings)) {
-        if (skipping) {
-            if (c == '\n') {
-                skipping = false;
-            }
-        }
-        else if (c == '#') {
-            skipping = true;
-        }
-        else if (!std::isspace(c)) {
-            break;
-        }
-    }
-
-    if (!c) {
-        return false;
-    }
-
-    cameraSettings = settings;
-    return true;
-}
