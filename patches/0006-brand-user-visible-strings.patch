+/** Destroys the object and frees any allocated resources */
+PythonConsole::~PythonConsole()
+{
+    saveHistory();
+    Base::PyGILStateLocker lock;
+    d->hGrpSettings->Detach(this);
+    Py_XDECREF(d->_stdoutPy);
+    Py_XDECREF(d->_stderrPy);
