+int MDIViewPage::addCommandsByName(QMenu& menu,
+                                   std::initializer_list<const char*> names)
+{
+    int count = 0;
+    auto& mgr = Gui::Application::Instance->commandManager();
+    for (const char* name : names) {
+        if (Gui::Command* c = mgr.getCommandByName(name)) {
+            c->addTo(&menu);
+            ++count;
+        }
+    }
+    return count;
+}
