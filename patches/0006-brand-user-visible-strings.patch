-bool MDIViewPage::onMsg(const char* pMsg)
-{
-    Gui::Document* doc(getGuiDocument());
-
-    if (!doc) {
-        return false;
-    }
-    else if (strcmp("ViewFit", pMsg) == 0) {
-        viewAll();
-        return true;
-    }
-    else if (strcmp("Save", pMsg) == 0) {
-        doc->save();
-        return true;
-    }
-    else if (strcmp("SaveAs", pMsg) == 0) {
-        doc->saveAs();
-        return true;
-    }
-    else if (strcmp("SaveCopy", pMsg) == 0) {
-        doc->saveCopy();
-        return true;
