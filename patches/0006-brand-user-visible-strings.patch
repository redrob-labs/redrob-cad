-    // view is already active
-    if (active == view) {
-        return;
-    }
-
-    // get all MDI views of the document
-    std::list<MDIView*> mdis = getMDIViews();
-
-    // this document is not active
-    if (std::ranges::find(mdis, active) == mdis.end()) {
