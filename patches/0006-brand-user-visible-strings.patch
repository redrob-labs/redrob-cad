-void DlgPreferencesImp::removePage(const std::string& className, const std::string& group)
-{
-    for (auto it = _pages.begin(); it != _pages.end(); ++it) {
-        if (it->first == group) {
-            if (className.empty()) {
-                _pages.erase(it);
-                return;
-            }
-
-            std::list<std::string>& p = it->second;
-            for (auto jt = p.begin(); jt != p.end(); ++jt) {
-                if (*jt == className) {
-                    p.erase(jt);
-                    if (p.empty()) {
-                        _pages.erase(it);
-                    }
-                    return;
-                }
-            }
-        }
-    }
