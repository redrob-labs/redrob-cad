+        connect(
+            this->preferencePackManagementDialog.get(),
+            &DlgPreferencePackManagementImp::packVisibilityChanged,
+            this,
+            &DlgSettingsGeneral::recreatePreferencePackMenu
+        );
+    }
+    this->preferencePackManagementDialog->show();
+}
