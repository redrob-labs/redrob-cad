// redrob_cad_setup.rc -- resources for the Redrob CAD branded setup and uninstaller.
//
// The payload (the MSI) and the committed PNGs and fonts are injected by
// build.py, which writes the file paths into the macros below before invoking
// rc. The uninstaller build defines REDROB_NO_PAYLOAD to omit the payload resource.

#include <windows.h>
#include "resource.h"
#include "build_defs.h"

// ---- icon ------------------------------------------------------------------
#ifdef REDROB_ICON_PATH
IDI_APPICON ICON REDROB_ICON_PATH
#endif

// ---- manifest (per-monitor-v2 DPI, common controls v6) ---------------------
IDR_MANIFEST RT_MANIFEST "redrob_cad_setup.manifest"

// ---- RCDATA ----------------------------------------------------------------
#ifndef REDROB_NO_PAYLOAD
IDR_PAYLOAD        RCDATA REDROB_PAYLOAD_PATH
#endif
IDR_BACKGROUND_PNG RCDATA REDROB_BACKGROUND_PATH
IDR_LOCKUP_PNG     RCDATA REDROB_LOCKUP_PATH
IDR_FONT_SANS      RCDATA REDROB_FONT_PATH
IDR_FONT_KR        RCDATA REDROB_FONT_KR_PATH

// ---- VERSIONINFO -----------------------------------------------------------
#ifndef REDROB_VER_FILE
#define REDROB_VER_FILE 0,0,0,0
#endif
#ifndef REDROB_VER_STR
#define REDROB_VER_STR "0.0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    REDROB_VER_FILE
 PRODUCTVERSION REDROB_VER_FILE
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Redrob"
            VALUE "FileDescription",  REDROB_FILE_DESC
            VALUE "FileVersion",      REDROB_VER_STR
            VALUE "InternalName",     REDROB_INTERNAL_NAME
            VALUE "OriginalFilename", REDROB_ORIGINAL_NAME
            VALUE "ProductName",      "Redrob CAD"
            VALUE "ProductVersion",   REDROB_VER_STR
            VALUE "LegalCopyright",   "Redrob"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
