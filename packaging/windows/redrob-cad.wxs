<?xml version="1.0" encoding="utf-8"?>
<!--
  Redrob CAD MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build redrob-cad.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, and Redrob CAD offered under
  "Open with" for .dxf and .dwg drawings (without taking over the user's default app).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Redrob CAD"
      Manufacturer="Redrob"
      Version="$(var.Version)"
      UpgradeCode="02B4F402-B78B-4D1B-B018-B59C5308CDD8"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Redrob CAD computer-aided design" Manufacturer="Redrob" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Redrob CAD is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="CadcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="CadcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/redrob-labs/redrob-cad" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/redrob-labs/redrob-cad" />
    <Property Id="ARPHELPLINK" Value="https://github.com/redrob-labs/redrob-cad/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Redrob CAD" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Redrob CAD" Level="1">
      <ComponentGroupRef Id="CadcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="CadcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="CadcraftApp" Guid="1978B0DF-DA84-41CA-8D7A-99B09F22E6F9">
        <File Id="CadcraftExe" Source="$(var.BinDir)\redrob-cad.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Redrob CAD"
              Description="Redrob CAD computer-aided design" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="CadcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\redrob-cad.exe" Value="[#CadcraftExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\redrob-cad.exe\shell\open\command" Value="&quot;[#CadcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dxf\OpenWithProgids" Name="RedrobCAD.Drawing" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dwg\OpenWithProgids" Name="RedrobCAD.Drawing" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\RedrobCAD.Drawing\shell\open\command" Value="&quot;[#CadcraftExe]&quot; &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="CadcraftCli">
        <File Id="CadcraftCliExe" Source="$(var.BinDir)\redrob-cad-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
